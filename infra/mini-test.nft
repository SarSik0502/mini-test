#!/usr/sbin/nft -f

# Replace only the project's tables in one transaction.
add table bridge mini_test
delete table bridge mini_test
add table inet mini_test
delete table inet mini_test

table bridge mini_test {
    set blocked_db_clients {
        type ipv4_addr
        flags timeout
        timeout 5m
    }

    chain forward {
        type filter hook forward priority 0; policy accept;

        meta ibrname "mt-web" jump web
        meta ibrname "mt-data" jump data
    }

    chain web {
        ether type arp accept
        ct state established,related accept
        ip saddr 172.29.141.2 ip daddr 172.29.141.3 tcp dport 8000 counter accept comment "frontend -> API"
        counter drop comment "deny other web connections"
    }

    chain data {
        ether type arp accept
        ip saddr @blocked_db_clients ip daddr { 172.29.142.3, 172.29.142.8 } tcp dport 5432 counter drop comment "demo: API -> PostgreSQL blocked"
        ct state established,related accept

        ip saddr { 172.29.142.2, 172.29.142.6, 172.29.142.7 } ip daddr { 172.29.142.3, 172.29.142.8 } tcp dport 5432 counter accept comment "API, worker, migrate -> PostgreSQL"
        ip saddr { 172.29.142.3, 172.29.142.8 } ip daddr { 172.29.142.3, 172.29.142.8 } tcp dport 5432 counter accept comment "PostgreSQL replication"
        ip saddr 172.29.142.2 ip daddr 172.29.142.4 tcp dport 6379 counter accept comment "API -> Redis"
        ip saddr { 172.29.142.2, 172.29.142.6 } ip daddr { 172.29.142.5, 172.29.142.9, 172.29.142.10 } tcp dport 4222 counter accept comment "API, worker -> NATS"
        ip saddr { 172.29.142.5, 172.29.142.9, 172.29.142.10 } ip daddr { 172.29.142.5, 172.29.142.9, 172.29.142.10 } tcp dport 6222 counter accept comment "NATS cluster routes"

        counter drop comment "deny other data connections"
    }
}

table inet mini_test {
    chain forward {
        type filter hook forward priority -5; policy accept;

        iifname "mt-web" oifname "mt-data" counter drop comment "deny routed web -> data"
        iifname "mt-data" oifname "mt-web" counter drop comment "deny routed data -> web"
    }
}
